// # oobasename Main Entry Point - Sovereign Path Stripper
//
// Logline: Strips directory prefixes and optional file extensions from path strings.
//
// Setup: Demands explicit capability tokens and standard argument list.
//
// Beats:
//   1. Parse command-line options and dispatch --help, --version, or --mcp.
//   2. Ingest path operands from arguments and apply suffix stripping.
//   3. Dispatch path transformations and output plain, NUL-terminated, or JSON text.

import "core/name_strip.oo";
import "render/name_theme.oo";
import "ipc/name_opts.oo";
import "ipc/mcp_serve.oo";

fn render_help() -> String {
    return "oobasename 0.2.0 (openOODA sovereign path & string)\n"
        + "usage: oobasename [options] NAME [SUFFIX]\n"
        + "   or: oobasename [options] -a NAME...\n\n"
        + "Strips directory prefixes and optional file extensions from path strings.\n\n"
        + "Options:\n"
        + "  -h, --help           display this help and exit\n"
        + "  -v, --version        output version information and exit\n"
        + "  -a, --multiple       support multiple arguments and treat each as a NAME\n"
        + "  -s, --suffix SUFFIX  remove a trailing SUFFIX; implies -a\n"
        + "  -z, --zero           end each output line with NUL, not newline\n"
        + "      --json           output formatted as JSON Lines\n"
        + "      --mcp            run as Model Context Protocol stdio server\n";
}

pub fn main(
    fs: &FsReadCap,
    proc_cap: &ProcessCap,
    env: &EnvCap,
    args: List[String]
) -> Result[Int, String] {
    let opts: NameOpts = parse_name_args(args);

    if opts.action == "help" {
        print(render_help());
        return Ok(0);
    }
    if opts.action == "version" {
        println("oobasename 0.2.0 (openOODA sovereign path & string)");
        return Ok(0);
    }
    if opts.action == "mcp" {
        run_mcp_server(fs);
        return Ok(0);
    }

    let num_paths: Int = list_len(opts.paths);
    if num_paths == 0 {
        println("oobasename: missing operand");
        println("Try 'oobasename --help' for more information.");
        return Ok(1);
    }

    let bases: List[String] = strip_paths(opts.paths, opts.suffix);

    if opts.json_mode {
        if num_paths == 1 {
            let single_p: String = list_get(opts.paths, 0);
            let single_b: String = list_get(bases, 0);
            println(render_basename_json(single_p, single_b, opts.suffix));
        } else {
            println(render_batch_json(opts.paths, bases, opts.suffix));
        }
        return Ok(0);
    }

    let delim: String = if opts.zero_terminated { "\x00" } else { "\n" };
    let mut i: Int = 0;
    while i < num_paths {
        let b: String = list_get(bases, i);
        print(b + delim);
        i = i + 1;
    }

    return Ok(0);
}
