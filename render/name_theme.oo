// # oobasename Rendering and JSON Formatter
//
// Logline: Formats basename results for terminal output and structured JSON envelopes.
//
// Setup: Pure string formatter supporting oote styling and JSON envelope serialization.
//
// Beats:
//   1. Provide ANSI styling helpers for terminal diagnostics and status tags.
//   2. Serialize individual basename extraction results into structured JSON objects.
//   3. Serialize batch path collections into structured JSON arrays.

pub fn ansi_reset() -> String { return "\x1b[0m"; }
pub fn ansi_bold() -> String { return "\x1b[1m"; }
pub fn ansi_dim() -> String { return "\x1b[2m"; }
pub fn ansi_cyan() -> String { return "\x1b[36m"; }
pub fn ansi_green() -> String { return "\x1b[32m"; }
pub fn ansi_yellow() -> String { return "\x1b[33m"; }
pub fn ansi_red() -> String { return "\x1b[31m"; }

fn json_escape(s: String) -> String {
    let mut out: String = "";
    let n: Int = chars_len(s);
    let mut i: Int = 0;
    while i < n {
        let c: String = char_at(s, i);
        if c == "\\" {
            out = out + "\\\\";
        } else if c == "\"" {
            out = out + "\\\"";
        } else if c == "\n" {
            out = out + "\\n";
        } else if c == "\r" {
            out = out + "\\r";
        } else if c == "\t" {
            out = out + "\\t";
        } else {
            out = out + c;
        }
        i = i + 1;
    }
    return out;
}

pub fn render_basename_json(path: String, result: String, suffix: String) -> String {
    return "{\"operation\":\"basename\""
        + ",\"path\":\"" + json_escape(path) + "\""
        + ",\"suffix\":\"" + json_escape(suffix) + "\""
        + ",\"basename\":\"" + json_escape(result) + "\"}";
}

pub fn render_batch_json(paths: List[String], results: List[String], suffix: String) -> String {
    let n: Int = list_len(paths);
    let mut entries: String = "";
    let mut i: Int = 0;
    while i < n {
        if i > 0 { entries = entries + ","; }
        let p: String = list_get(paths, i);
        let b: String = list_get(results, i);
        entries = entries + "{\"path\":\"" + json_escape(p) + "\",\"basename\":\"" + json_escape(b) + "\"}";
        i = i + 1;
    }
    return "{\"operation\":\"basename_batch\""
        + ",\"count\":" + to_string(n)
        + ",\"suffix\":\"" + json_escape(suffix) + "\""
        + ",\"items\":[" + entries + "]}";
}
